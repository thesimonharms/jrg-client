{
  "name": "jrg-client",
  "version": "0.1.0",
  "description": "TypeScript client for fetching Jaringan (JRG) pages — supports HTTP gateway, raw TCP, and local file transports",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "bun test"
  },
  "keywords": [
    "jaringan",
    "jrg",
    "protocol",
    "client",
    "decentralized",
    "hypermedia",
    "p2p"
  ],
  "license": "MIT",
  "author": "Simon Harms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesimonharms/jrg-client.git"
  },
  "bugs": {
    "url": "https://github.com/thesimonharms/jrg-client/issues"
  },
  "homepage": "https://github.com/thesimonharms/jrg-client#readme",
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
